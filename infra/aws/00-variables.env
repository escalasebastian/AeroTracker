# AeroTracker AWS Infrastructure Variables
AWS_REGION="eu-west-1"
VPC_NAME="aerotracker-vpc"
VPC_CIDR="10.0.0.0/16"

# Subnets
PUB_SUB1_CIDR="10.0.1.0/24"
PUB_SUB1_AZ="eu-west-1a"
PUB_SUB2_CIDR="10.0.2.0/24"
PUB_SUB2_AZ="eu-west-1b"

PRIV_SUB1_CIDR="10.0.10.0/24"
PRIV_SUB1_AZ="eu-west-1a"
PRIV_SUB2_CIDR="10.0.20.0/24"
PRIV_SUB2_AZ="eu-west-1b"

# Security Groups
EC2_SG_NAME="aerotracker-ec2-sg"
RDS_SG_NAME="aerotracker-rds-sg"

# RDS PostgreSQL
RDS_DB_NAME="aerotracker"
RDS_DB_IDENTIFIER="aerotracker-db"
RDS_MASTER_USER="aerotracker_admin"
RDS_CLASS="db.t3.micro"
RDS_ALLOCATED_STORAGE=20
